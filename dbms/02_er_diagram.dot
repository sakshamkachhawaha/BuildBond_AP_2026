digraph BuildBondER {
  graph [rankdir=LR, splines=true, overlap=false, nodesep=0.30, ranksep=0.9,
         fontname="Helvetica", bgcolor="white", pad=0.3,
         label="BuildBond — AP DBMS CP2 ER diagram\nPK = primary key, FK = foreign key, UQ = unique; edges show cardinality",
         labelloc="t", fontsize=14];
  node [shape=plaintext, fontname="Helvetica", fontsize=9];
  edge [fontname="Helvetica", fontsize=8, color="#6b7280", fontcolor="#374151", dir=both, arrowtail=odot, arrowhead=crow, penwidth=1.0];
  users [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="white"><tr><td colspan="3" bgcolor="#dbeafe" align="center"><font point-size="13"><b>users</b></font></td></tr><tr><td align="left"><font color="#111827">id</font></td><td align="left"><font color="#4b5563">serial</font></td><td align="left"><font color="#b91c1c"><b>PK</b></font></td></tr><tr><td align="left"><font color="#111827">name</font></td><td align="left"><font color="#4b5563">text</font></td><td align="left"><font color="#374151"> </font></td></tr><tr><td align="left"><font color="#111827">email</font></td><td align="left"><font color="#4b5563">text</font></td><td align="left"><font color="#374151"><b>UQ</b></font></td></tr><tr><td align="left"><font color="#111827">password_hash</font></td><td align="left"><font color="#4b5563">text</font></td><td align="left"><font color="#374151"> </font></td></tr><tr><td align="left"><font color="#111827">role</font></td><td align="left"><font color="#4b5563">text</font></td><td align="left"><font color="#374151"> </font></td></tr><tr><td align="left"><font color="#111827">created_at</font></td><td align="left"><font color="#4b5563">timestamptz</font></td><td align="left"><font color="#374151"> </font></td></tr></table>>];
  projects [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="white"><tr><td colspan="3" bgcolor="#e0e7ff" align="center"><font point-size="13"><b>projects</b></font></td></tr><tr><td align="left"><font color="#111827">id</font></td><td align="left"><font color="#4b5563">serial</font></td><td align="left"><font color="#b91c1c"><b>PK</b></font></td></tr><tr><td align="left"><font color="#111827">client_id</font></td><td align="left"><font color="#4b5563">integer</font></td><td align="left"><font color="#1d4ed8"><b>FK</b></font></td></tr><tr><td align="left"><font color="#111827">contractor_id</font></td><td align="left"><font color="#4b5563">integer</font></td><td align="left"><font color="#1d4ed8"><b>FK</b></font></td></tr><tr><td align="left"><font color="#111827">title</font></td><td align="left"><font color="#4b5563">text</font></td><td align="left"><font color="#374151"> </font></td></tr><tr><td align="left"><font color="#111827">total_paise</font></td><td align="left"><font color="#4b5563">integer</font></td><td align="left"><font color="#374151"> </font></td></tr><tr><td align="left"><font color="#111827">status</font></td><td align="left"><font color="#4b5563">text</font></td><td align="left"><font color="#374151"> </font></td></tr></table>>];
  milestones [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="white"><tr><td colspan="3" bgcolor="#dcfce7" align="center"><font point-size="13"><b>milestones</b></font></td></tr><tr><td align="left"><font color="#111827">id</font></td><td align="left"><font color="#4b5563">serial</font></td><td align="left"><font color="#b91c1c"><b>PK</b></font></td></tr><tr><td align="left"><font color="#111827">project_id</font></td><td align="left"><font color="#4b5563">integer</font></td><td align="left"><font color="#1d4ed8"><b>FK</b></font></td></tr><tr><td align="left"><font color="#111827">position</font></td><td align="left"><font color="#4b5563">integer</font></td><td align="left"><font color="#374151"><b>UQ</b></font></td></tr><tr><td align="left"><font color="#111827">title</font></td><td align="left"><font color="#4b5563">text</font></td><td align="left"><font color="#374151"> </font></td></tr><tr><td align="left"><font color="#111827">amount_paise</font></td><td align="left"><font color="#4b5563">integer</font></td><td align="left"><font color="#374151"> </font></td></tr><tr><td align="left"><font color="#111827">status</font></td><td align="left"><font color="#4b5563">text</font></td><td align="left"><font color="#374151"> </font></td></tr></table>>];
  proofs [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="white"><tr><td colspan="3" bgcolor="#fef3c7" align="center"><font point-size="13"><b>proofs</b></font></td></tr><tr><td align="left"><font color="#111827">id</font></td><td align="left"><font color="#4b5563">serial</font></td><td align="left"><font color="#b91c1c"><b>PK</b></font></td></tr><tr><td align="left"><font color="#111827">milestone_id</font></td><td align="left"><font color="#4b5563">integer</font></td><td align="left"><font color="#1d4ed8"><b>FK</b></font></td></tr><tr><td align="left"><font color="#111827">submitted_by</font></td><td align="left"><font color="#4b5563">integer</font></td><td align="left"><font color="#1d4ed8"><b>FK</b></font></td></tr><tr><td align="left"><font color="#111827">url</font></td><td align="left"><font color="#4b5563">text</font></td><td align="left"><font color="#374151"> </font></td></tr><tr><td align="left"><font color="#111827">note</font></td><td align="left"><font color="#4b5563">text</font></td><td align="left"><font color="#374151"> </font></td></tr><tr><td align="left"><font color="#111827">status</font></td><td align="left"><font color="#4b5563">text</font></td><td align="left"><font color="#374151"> </font></td></tr><tr><td align="left"><font color="#111827">review_note</font></td><td align="left"><font color="#4b5563">text</font></td><td align="left"><font color="#374151"> </font></td></tr><tr><td align="left"><font color="#111827">reviewed_by</font></td><td align="left"><font color="#4b5563">integer</font></td><td align="left"><font color="#1d4ed8"><b>FK</b></font></td></tr></table>>];
  ledger_entries [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="white"><tr><td colspan="3" bgcolor="#ffe4e6" align="center"><font point-size="13"><b>ledger_entries</b></font></td></tr><tr><td align="left"><font color="#111827">id</font></td><td align="left"><font color="#4b5563">serial</font></td><td align="left"><font color="#b91c1c"><b>PK</b></font></td></tr><tr><td align="left"><font color="#111827">project_id</font></td><td align="left"><font color="#4b5563">integer</font></td><td align="left"><font color="#1d4ed8"><b>FK</b></font></td></tr><tr><td align="left"><font color="#111827">milestone_id</font></td><td align="left"><font color="#4b5563">integer</font></td><td align="left"><font color="#1d4ed8"><b>FK</b></font></td></tr><tr><td align="left"><font color="#111827">kind</font></td><td align="left"><font color="#4b5563">text</font></td><td align="left"><font color="#374151"> </font></td></tr><tr><td align="left"><font color="#111827">amount_paise</font></td><td align="left"><font color="#4b5563">integer</font></td><td align="left"><font color="#374151"> </font></td></tr></table>>];
  events [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="white"><tr><td colspan="3" bgcolor="#f3e8ff" align="center"><font point-size="13"><b>events</b></font></td></tr><tr><td align="left"><font color="#111827">id</font></td><td align="left"><font color="#4b5563">serial</font></td><td align="left"><font color="#b91c1c"><b>PK</b></font></td></tr><tr><td align="left"><font color="#111827">project_id</font></td><td align="left"><font color="#4b5563">integer</font></td><td align="left"><font color="#1d4ed8"><b>FK</b></font></td></tr><tr><td align="left"><font color="#111827">actor_id</font></td><td align="left"><font color="#4b5563">integer</font></td><td align="left"><font color="#1d4ed8"><b>FK</b></font></td></tr><tr><td align="left"><font color="#111827">kind</font></td><td align="left"><font color="#4b5563">text</font></td><td align="left"><font color="#374151"> </font></td></tr><tr><td align="left"><font color="#111827">message</font></td><td align="left"><font color="#4b5563">text</font></td><td align="left"><font color="#374151"> </font></td></tr><tr><td align="left"><font color="#111827">created_at</font></td><td align="left"><font color="#4b5563">timestamptz</font></td><td align="left"><font color="#374151"> </font></td></tr></table>>];
  disputes [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="white"><tr><td colspan="3" bgcolor="#ffedd5" align="center"><font point-size="13"><b>disputes</b></font></td></tr><tr><td align="left"><font color="#111827">id</font></td><td align="left"><font color="#4b5563">serial</font></td><td align="left"><font color="#b91c1c"><b>PK</b></font></td></tr><tr><td align="left"><font color="#111827">project_id</font></td><td align="left"><font color="#4b5563">integer</font></td><td align="left"><font color="#1d4ed8"><b>FK</b></font></td></tr><tr><td align="left"><font color="#111827">milestone_id</font></td><td align="left"><font color="#4b5563">integer</font></td><td align="left"><font color="#1d4ed8"><b>FK</b></font></td></tr><tr><td align="left"><font color="#111827">raised_by</font></td><td align="left"><font color="#4b5563">integer</font></td><td align="left"><font color="#1d4ed8"><b>FK</b></font></td></tr><tr><td align="left"><font color="#111827">reason</font></td><td align="left"><font color="#4b5563">text</font></td><td align="left"><font color="#374151"> </font></td></tr><tr><td align="left"><font color="#111827">status</font></td><td align="left"><font color="#4b5563">text</font></td><td align="left"><font color="#374151"> </font></td></tr></table>>];
  users -> projects [label="1 : N  client"];
  users -> projects [label="0..1 : N  contractor"];
  projects -> milestones [label="1 : N"];
  milestones -> proofs [label="1 : N"];
  users -> proofs [label="1 : N  submitted_by"];
  users -> proofs [label="0..1 : N  reviewed_by"];
  projects -> ledger_entries [label="1 : N"];
  milestones -> ledger_entries [label="0..1 : N  release"];
  projects -> events [label="1 : N"];
  users -> events [label="1 : N  actor"];
  projects -> disputes [label="1 : N"];
  milestones -> disputes [label="1 : N  on milestone"];
  users -> disputes [label="1 : N  raised_by"];
  notes [shape=note, style="filled", fillcolor="#fefce8", fontsize=9, label="Business rules enforced by partial unique indexes:\l  • one SUBMITTED proof per milestone\l  • one DEPOSIT per project\l  • one RELEASE per milestone\l  • one OPEN dispute per milestone\l\lMoney is integer paise. Ledger is append-only;\lheld = deposited - released is derived.\lComposite FKs keep a RELEASE/dispute\lwith the milestone's project.\l"];
}
